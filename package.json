{
  "name": "dsh-plugin-security-review",
  "description": "Security review gate for DeepSeek Harness (dsh) plugins: static pre-install vetting of malicious code, vulnerabilities and supply-chain risks (with deobfuscation decoding), runtime audit, optional tool-call guard, and a one-click review/install/uninstall panel that works in both the web GUI and the dsh desktop client.",
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.0-rc.6"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./analyzer": "./lib/analyzer/index.js",
    "./cli": "./lib/cli/index.js",
    "./desktop": "./lib/desktop.js",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "bin": {
    "dsh-safe-plugin": "lib/cli/index.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "license": "MIT",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "external": []
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "security",
    "audit",
    "supply-chain"
  ],
  "author": "ateen18",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ateen18/dsh-plugin-security-review.git"
  },
  "bugs": {
    "url": "https://github.com/ateen18/dsh-plugin-security-review/issues"
  },
  "homepage": "https://github.com/ateen18/dsh-plugin-security-review#readme",
  "optionalDependencies": {
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "check": "node scripts/check.js"
  }
}
